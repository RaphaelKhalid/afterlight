{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afterlight-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "OWNER_BUDGET_USD": "25",
    "OPENAI_BUDGET_USD": "25",
    "EXA_BUDGET_USD": "10",
    "OPENROUTER_BUDGET_USD": "6",
    "TELEGRAM_ALLOWED_CHAT_IDS": "chat1",
    "OWNER_ACCESS_TOKEN": "integration-owner",
    "TELEGRAM_WEBHOOK_SECRET": "integration-telegram"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "afterlight-research", "database_id": "7455423a-6856-43f6-8ac3-210c9cadcb04", "migrations_dir": "migrations" }],
  "workflows": [{ "binding": "AFTERLIGHT_WORKFLOW", "name": "afterlight-experiment-test", "class_name": "AfterlightWorkflow" }]
}
