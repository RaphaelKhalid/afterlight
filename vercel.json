{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "afterlight-blond.vercel.app" }],
      "destination": "https://afterlight-research.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "afterlight-raphaelkhalids-projects.vercel.app" }],
      "destination": "https://afterlight-research.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://afterlight-api.raphaelbahadurkhan.workers.dev/api/:path*"
    }
  ]
}
